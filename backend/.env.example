# Copy this file to backend/.env and edit the copy.
# backend/.env is ignored by Git. Never put real keys in this example file.
# Every variable is optional for the current scaffold, which makes no model calls.

# Browser origins allowed to call the API, separated by commas.
# Add the deployed frontend origin here when there is one.
HETU_CORS_ORIGINS=http://localhost:5173

# --- Inference (not implemented yet; nothing reads these values today) ---
# The provider and model are chosen here, not in code.
# Candidates under evaluation. None has been validated with Hetu yet.
#   groq       openai/gpt-oss-20b     first candidate
#   groq       openai/gpt-oss-120b    alternative
#   mistralai  mistral-small-latest   alternative (Mistral Small 4)
HETU_LLM_PROVIDER=
HETU_LLM_MODEL=

# Set only the key for the provider selected above.
# Keys stay on the server. Never use a VITE_ variable for a key.
GROQ_API_KEY=
MISTRAL_API_KEY=
