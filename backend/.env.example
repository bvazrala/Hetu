# Copy this file to backend/.env and edit the copy.
# backend/.env is ignored by Git. Never put real keys in this example file.

# Browser origins allowed to call the API, separated by commas.
# Add the deployed frontend origin here when there is one.
HETU_CORS_ORIGINS=http://localhost:5173

# --- Model -------------------------------------------------------------
# The provider and model are chosen here, not in code. Leave both empty
# and POST /analyze answers 503 while everything else keeps working.
#
# Candidates. None is validated until scripts/validate_model.py passes.
#   groq       openai/gpt-oss-120b    larger; did better in the first validation runs
#   groq       openai/gpt-oss-20b     smaller and cheaper
#   mistralai  mistral-small-latest   Mistral Small 4. First run: uv add langchain-mistralai
HETU_LLM_PROVIDER=groq
HETU_LLM_MODEL=openai/gpt-oss-120b

# 0 makes repeated runs on the same draft agree as often as the provider allows.
HETU_LLM_TEMPERATURE=0

# Set only the key for the provider selected above.
# Keys stay on the server. Never use a VITE_ variable for a key.
GROQ_API_KEY=

# --- Workflow ------------------------------------------------------------
# deep_agent: an orchestrator that can consult a critic subagent.
# direct:     one structured model call, with no tool calling.
HETU_WORKFLOW=deep_agent

# Upper bound on one analysis, in seconds.
HETU_ANALYZE_TIMEOUT_SECONDS=60
