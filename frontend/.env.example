# Copy this file to frontend/.env.local and edit the copy.
# Vite exposes every VITE_ variable to the browser. Never put a secret here.

# Base URL of the Hetu API.
VITE_API_BASE_URL=http://localhost:8000

# Accounts. Both come from the Neon Console and are public addresses, not
# secrets: the Data API returns only the signed-in user's own rows. Leave
# both empty and Hetu runs for guests only, with no Sign in button.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
